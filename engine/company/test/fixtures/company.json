{
  "company": { "name": "Sthyra", "requireOwnerApprovalForNewAgents": true },
  "project": { "name": "Company work", "folder": "{state}/tasks/company-work" },
  "defaults": {
    "limits": { "maxConcurrentRuns": 1, "runMinutes": 15, "maxTurns": 40 },
    "rights": { "canAssignTasks": false, "canCreateAgents": false, "canCreateSkills": false },
    "grants": ["tools:use", "inbox:manage", "tasks:assign_scope", "tasks:manage_active_checkouts"],
    "fencePolicy": {
      "localServices": [], "readFolders": ["{state}/knowledge/docs"],
      "lessonsFile": "{state}/lessons/{slug}.md", "envFile": null, "taskFolder": "read-write"
    }
  },
  "agents": [
    {
      "slug": "chief-of-staff", "name": "Chief of staff", "role": "Chief of staff",
      "paperclipRole": "pm", "title": "Chief of staff",
      "tool": "claude", "model": "opus", "reportsTo": null,
      "capabilities": "Turns the owner's goals into tasks.",
      "instructions": "roles/chief-of-staff.md",
      "rights": { "canAssignTasks": true },
      "grants": ["tasks:assign", "tools:use", "inbox:manage", "tasks:assign_scope", "tasks:manage_active_checkouts"],
      "bench": null
    },
    {
      "slug": "checker", "name": "Checker", "role": "Checker",
      "paperclipRole": "qa", "title": "Checker",
      "tool": "codex", "model": null, "reportsTo": "chief-of-staff",
      "capabilities": "Checks finished work.",
      "instructions": "roles/checker.md",
      "fencePolicy": { "taskFolder": "read-only" },
      "bench": null
    },
    {
      "slug": "bookkeeper", "name": "Bookkeeper", "role": "Bookkeeper",
      "paperclipRole": "general", "title": "Bookkeeper",
      "tool": "claude", "model": "sonnet", "reportsTo": "chief-of-staff",
      "capabilities": "Keeps the books as drafts.",
      "instructions": "roles/bookkeeper.md",
      "limits": { "maxTurns": 60 },
      "fencePolicy": {
        "localServices": ["127.0.0.1:8120"],
        "envFile": "{state}/secrets/agents/bookkeeper.env"
      },
      "bench": { "user": "bookkeeper@engine.localhost", "role": "Engine Bookkeeper" }
    }
  ]
}
