#!/usr/bin/env bash
# Claude Code inside the fence. Paperclip only activates a claude_local agent
# whose command is a file named `claude` (runner legacy, engine cli), so this
# file is the wrapper under that name, and this folder goes first on the
# board's PATH: every Claude agent is fenced by default.
# The agent keeps its own config folder (state/claude-home/<agent id>). In plans
# mode it signs in with its own token (state/agent.env, made by login-wizard.sh);
# in provider mode it talks to the model relay with a token minted for this run,
# and the login file is never opened (PLAN-V4, C6).
set -euo pipefail
for _v in $(compgen -e); do
  case "$_v" in FENCE_*|UUU_*) unset "$_v" ;; esac
done
unset ENGINE_CONFIG _v

FENCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
refuse() { echo "fence: $1" >&2; exit 78; }
OWNER_HOME="$(/usr/bin/python3 -I -c "import os,pwd;print(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))")" \
  || refuse "could not find your home folder"
_given_home="${HOME:-}"; HOME="$OWNER_HOME"
. "$FENCE_DIR/../lib/config.sh" || refuse "the engine config could not be read. Check engine/config.json"
HOME="$_given_home"; unset _given_home
STATE_DIR="$CFG_STATE"

# Each agent has a Claude Code config folder of its own: settings, CLAUDE.md,
# commands, hooks and MCP entries one agent writes there never load in another
# agent's run (their rights differ). The agent id is the one fence-run uses to
# find the fence policy. A run without one (the proof, the quota check) gets
# `_none`, never the parent folder, which holds all the others.
_agent="${PAPERCLIP_AGENT_ID:-}"
if [[ -z "$_agent" ]]; then
  _agent="_none"
elif [[ ! "$_agent" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
  refuse "the agent id is malformed, so no Claude home can be picked for it"
fi
HOMES="$STATE_DIR/claude-home"
AGENT_HOME="$HOMES/$_agent"
unset _agent
mkdir -p "$HOMES" || refuse "could not make $HOMES"
[[ ! -L "$HOMES" && -d "$HOMES" && -O "$HOMES" ]] || refuse "$HOMES is not a plain folder of yours"
if [[ ! -e "$AGENT_HOME" && ! -L "$AGENT_HOME" ]]; then
  mkdir -m 700 "$AGENT_HOME" || refuse "could not make the agent's Claude home $AGENT_HOME"
fi
[[ ! -L "$AGENT_HOME" ]] || refuse "the agent's Claude home $AGENT_HOME is a link; the fence only trusts a plain folder"
[[ -d "$AGENT_HOME" && -O "$AGENT_HOME" ]] || refuse "the agent's Claude home $AGENT_HOME is not a folder of yours"
_mode="$(stat -f '%Lp' "$AGENT_HOME")" || refuse "could not check the agent's Claude home"
(( (8#$_mode & 8#022) == 0 )) || refuse "the agent's Claude home $AGENT_HOME can be changed by others"
unset _mode

# The proof tests the fence itself this way; it needs no login.
if [[ "${1:-}" == "--fence-check" ]]; then
  [[ $# -eq 2 ]] || refuse "--fence-check takes exactly one shell command"
  exec "$FENCE_DIR/fence-run" --tool claude --agent-home "$AGENT_HOME" -c "$2"
fi

# Which models this run uses (model_mode.py, outside the fence): plans, or
# provider with the relay's address, this agent's pick and a token for the relay.
# Its refusal (exit 78, its own sentence) is ours. The token is kept only in a
# shell variable and then the program's environment; never on a command line.
MODEL_MODE=""
if [[ -z "${PAPERCLIP_AGENT_ID:-}" ]]; then
  MODEL_MODE="$(/usr/bin/python3 -I "$FENCE_DIR/model_mode.py" --mode </dev/null)" \
    || { [[ $? -eq 78 ]] && exit 78; refuse "the model settings could not be read"; }
  [[ "$MODEL_MODE" == plans ]] \
    || refuse "the provider is on, and a run without an agent id has no model. The proof passes a real agent's id."
else
  _for_run="$(/usr/bin/python3 -I "$FENCE_DIR/model_mode.py" --for-run --agent "$PAPERCLIP_AGENT_ID" </dev/null)" \
    || { [[ $? -eq 78 ]] && exit 78; refuse "the model settings could not be read"; }
  MODEL_MODE="${_for_run%%$'\n'*}"; _for_run="${_for_run#*$'\n'}"
  _relay="${_for_run%%$'\n'*}"; _for_run="${_for_run#*$'\n'}"
  _pick="${_for_run%%$'\n'*}"; _relay_token="${_for_run#*$'\n'}"
  unset _for_run
fi
case "$MODEL_MODE" in
  plans) ;;
  provider)
    [[ "$_relay" =~ ^http://127\.0\.0\.1:[0-9]{1,5}$ ]] || refuse "the model relay's address is not a local one"
    [[ "$_pick" =~ ^[a-z0-9.-]{1,80}$ ]] || refuse "the model picked for this agent is not a model name"
    [[ "$_relay_token" =~ ^v1\.a\.[0-9a-f-]{36}\.[0-9]{1,12}\.[0-9a-f]{64}$ ]] || refuse "the token for the model relay is malformed"
    ;;
  *) refuse "the model settings gave no mode" ;;
esac

if [[ "$MODEL_MODE" == plans ]]; then
  ENV_FILE="$STATE_DIR/agent.env"
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "No agent login yet. Run: engine/fence/login-wizard.sh" >&2
    exit 78
  fi
  # The file is sourced, so it must be a plain file of ours that nobody else can change.
  [[ ! -L "$ENV_FILE" && -O "$ENV_FILE" ]] || refuse "the agent login file is not a plain file of yours. Run: engine/fence/login-wizard.sh"
  _mode="$(stat -f '%Lp' "$ENV_FILE")" || refuse "could not check the agent login file"
  (( (8#$_mode & 8#022) == 0 )) || refuse "the agent login file can be changed by others. Run: chmod 600 on it"
  unset _mode
  set -a; . "$ENV_FILE"; set +a
  unset OPENAI_API_KEY ANTHROPIC_API_KEY
  export CLAUDE_CONFIG_DIR="$AGENT_HOME"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

else
  # Provider mode. Nothing here may carry the owner's Claude login or any other
  # credential to the relay: drop every name the program reads for a credential,
  # a profile, extra headers or a cloud switch (by pattern and by name, the
  # names from the installed program, T1), then give it the relay and the pick.
  for _v in $(compgen -e); do
    case "$_v" in
      ANTHROPIC_*|CLAUDE_CODE_USE_*|CLAUDE_CODE_OAUTH_*|CLAUDE_CODE_GATEWAY_*|CLAUDE_CODE_API_KEY_*|AWS_BEARER_TOKEN_*) unset "$_v" ;;
    esac
  done
  unset _v CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_OAUTH_REFRESH_TOKEN \
    ANTHROPIC_API_KEY CLAUDE_API_KEY CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR OPENAI_API_KEY \
    ANTHROPIC_PROFILE ANTHROPIC_CONFIG_DIR ANTHROPIC_CUSTOM_HEADERS ANTHROPIC_BETAS ANTHROPIC_UNIX_SOCKET \
    ANTHROPIC_API_HOST ANTHROPIC_IDENTITY_TOKEN ANTHROPIC_IDENTITY_TOKEN_FILE \
    CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_USE_MANTLE \
    CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD CLAUDE_CODE_USE_GATEWAY \
    CLAUDE_CODE_GATEWAY_TOKEN CLAUDE_CODE_GATEWAY_TOKEN_FILE_DESCRIPTOR \
    ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_BEDROCK_MANTLE_BASE_URL ANTHROPIC_VERTEX_BASE_URL \
    ANTHROPIC_FOUNDRY_BASE_URL ANTHROPIC_AWS_BASE_URL ANTHROPIC_GOOGLE_CLOUD_BASE_URL \
    ANTHROPIC_AWS_API_KEY ANTHROPIC_FOUNDRY_API_KEY ANTHROPIC_FOUNDRY_AUTH_TOKEN AWS_BEARER_TOKEN_BEDROCK
  # Every call names the pick (the relay forces it too). Thinking stays on.
  # CLAUDE_CODE_DISABLE_WEB_FETCH is left out: the installed program has no such switch (T1).
  export ANTHROPIC_BASE_URL="$_relay" ANTHROPIC_AUTH_TOKEN="$_relay_token"
  export ANTHROPIC_MODEL="$_pick" ANTHROPIC_DEFAULT_HAIKU_MODEL="$_pick" ANTHROPIC_DEFAULT_SONNET_MODEL="$_pick"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$_pick" ANTHROPIC_DEFAULT_FABLE_MODEL="$_pick" CLAUDE_CODE_SUBAGENT_MODEL="$_pick"
  export CLAUDE_CONFIG_DIR="$AGENT_HOME"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  unset _relay _relay_token
fi
# Paperclip hands Claude extra folders (its skills) with --add-dir, and files for
# this run (instructions, tool config) by path. The fence may read those, and only
# when they sit inside paperclip's own company or skills folders.
INSTANCE_REAL="$(cd "$CFG_INSTANCE_ROOT" 2>/dev/null && pwd -P)" || refuse "paperclip's folder $CFG_INSTANCE_ROOT is missing"
READS=()
share() {
  local path="$1" real=""
  [[ -e "$path" ]] || return 0       # nothing there to read
  if [[ -d "$path" ]]; then real="$(cd "$path" && pwd -P)"; else real="$(cd "$(dirname "$path")" && pwd -P)"; fi
  case "$real" in
    "$INSTANCE_REAL"/companies/*|"$INSTANCE_REAL"/skills/*) READS+=(--read "$real") ;;
    *) refuse "paperclip asked to share $path with the agent, which is outside its own folders" ;;
  esac
}
# The skills in an --add-dir folder are links into paperclip's skills tree: share
# what they point at too, or Claude sees the links and loads no skill.
share_dir() {
  local dir="$1" skills target
  share "$dir"
  [[ -d "$dir" ]] || return 0
  skills="$(/usr/bin/python3 -I "$FENCE_DIR/claude_skills.py" "$dir" "$INSTANCE_REAL")" \
    || refuse "paperclip asked to share a skill with the agent that lies outside its own folders"
  while IFS= read -r target; do
    [[ -n "$target" ]] && share "$target"
  done <<EOF
$skills
EOF
}
# The version and help questions get no program flags (below), decided on
# paperclip's own arguments before the pick is added.
case "$*" in --version|-v|-V|--help|-h) _no_web="" ;; *) _no_web=1 ;; esac
# In provider mode the model paperclip names (--model x or --model=x) becomes the
# pick, and a run that names none gets --model <pick> at the end.
ARGS=()
_named=""
prev=""
for arg in "$@"; do
  case "$prev" in
    --add-dir) share_dir "$arg" ;;
    --append-system-prompt-file|--mcp-config|--settings) if [[ -f "$arg" ]]; then share "$arg"; fi ;;
  esac
  case "$arg" in --add-dir=*) share_dir "${arg#--add-dir=}" ;; esac
  if [[ "$MODEL_MODE" == provider ]]; then
    if [[ "$prev" == --model ]]; then
      ARGS+=("$_pick")
    elif [[ "$arg" == --model=* ]]; then
      ARGS+=("--model=$_pick"); _named=1
    else
      ARGS+=("$arg")
      if [[ "$arg" == --model ]]; then _named=1; fi
    fi
  fi
  prev="$arg"
done
if [[ "$MODEL_MODE" == provider ]]; then
  if [[ -z "$_named" ]]; then ARGS+=(--model "$_pick")
  elif [[ "$prev" == --model ]]; then ARGS+=("$_pick")
  fi
  set -- "${ARGS[@]}"
fi
unset ARGS _named _pick

# No agent searches or fetches through the program itself: the web is the web
# door's, for the one agent it serves (PLAN-V5, K2b as T1 found it). The flag goes
# after paperclip's own arguments (the prompt comes on stdin), once, and not on
# the version and help questions. `--setting-sources user` is left out: it stops
# paperclip's own skills from loading (T1).
if [[ -n "$_no_web" ]]; then
  _tail=""
  if [[ $# -ge 3 ]]; then _tail="$(printf '%s\n' "${@: -3}")"; fi
  if [[ "$_tail" != $'--disallowedTools\nWebSearch\nWebFetch' ]]; then
    set -- "$@" --disallowedTools WebSearch WebFetch
  fi
fi
unset _no_web _tail

# Call the real Claude Code by its full path: this wrapper is itself a file named `claude`.
exec "$FENCE_DIR/fence-run" --tool claude --agent-home "$AGENT_HOME" \
  ${READS[@]+"${READS[@]}"} -- "$CFG_REAL_CLAUDE" "$@"
