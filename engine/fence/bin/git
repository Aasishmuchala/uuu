#!/bin/bash
# The board runs git inside the agents' task folders (to see whether a folder
# has changes). An agent can write anything in its task folder, including the
# files of a made-up git repository whose settings name a program for git to
# run. Git would then run that program as the owner, outside the fence.
#
# This file sits first on the board's PATH, beside the fenced `claude` and
# `codex`, so every git the board starts goes through it. It:
#   - refuses to run at all when git would work in a folder an agent can write
#     to: anything under the engine's state folder, paperclip's `workspaces`
#     and `isolated-workspaces` (the folder git starts in, every `-C`, and any
#     `--git-dir`, `--work-tree`, `--exec-path` or GIT_DIR-style variable).
#     Git then says "not a git repository", which is what the board sees for
#     every task folder anyway. Folders are compared by their one true path,
#     in any letter case and under any other name for the same disk; a path
#     under /.vol (a folder named by number) is refused outright. No
#     repository there is ever opened, so no
#     setting an agent writes there (a repository laid out directly in the
#     folder, a `.git` file pointing anywhere, `.gitattributes` with a filter,
#     `core.worktree` pointing outside) is ever read;
#   - makes the real git refuse a repository laid out directly in a folder (git
#     calls it "bare") and ignore the file-watcher hook and the hooks folder,
#     wherever it runs;
#   - never climbs above the owner's home folder to find a repository. The home
#     folder is itself a git repository here, so without this every scan of a
#     task folder ran `git status` over the whole home folder (and timed out).
# The folders come from engine/config.json, never from the environment. When
# the config cannot be read, git is refused everywhere.
# Found by the final security review on 11 November 2026.
unset ENGINE_CONFIG
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../lib" 2>/dev/null && pwd -P)" || LIB_DIR=""

# -I: the folder git runs in may be an agent's, so Python must not import from it.
# shellcheck disable=SC2016
GUARD='
import os, pwd, sys
lib, args = sys.argv[1], sys.argv[2:]
def no(why):
    sys.stderr.write("fatal: not a git repository: %s\n" % why)
    sys.exit(128)
os.environ["HOME"] = os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)
os.environ.pop("ENGINE_CONFIG", None)
try:
    sys.path.insert(0, lib)
    import config
    cfg = config.load_config()
    inst = cfg["paperclip"]["instanceRoot"]
    trees = [cfg["stateRoot"], os.path.join(inst, "workspaces"), os.path.join(inst, "isolated-workspaces")]
except Exception:
    no("the engine config could not be read, so the engine does not run git")
# Every folder is compared by its one true path: each folder that exists is
# entered and the system asked where it is (what `cd -P` then `pwd -P` do), which
# undoes links, the /System/Volumes/Data and /.vol names for the same disk and,
# on this Mac, other letter case. Comparisons are also made in folded case,
# because the disk ignores case. A path that does not exist is resolved up to
# its nearest existing folder and the rest appended.
def numbered(p):
    p = "/" + p.lstrip("/")
    q = p.casefold()
    return q == "/.vol" or q.startswith("/.vol/")
def phys(p):
    if numbered(p):
        no("%s names a folder by number (/.vol), and the engine never runs git there" % p)
    parts = p.split("/")
    done = "/"
    for k, part in enumerate(parts):
        if part in ("", "."):
            continue
        nxt = os.path.join(done, part)
        if os.path.isdir(nxt):
            try:
                os.chdir(nxt)
                done = os.getcwd()
            except OSError:
                return os.path.normpath(os.path.join(nxt, *parts[k + 1:]))
            continue
        if os.path.lexists(nxt):
            real = os.path.realpath(nxt)
            if numbered(real):
                no("%s names a folder by number (/.vol), and the engine never runs git there" % p)
            try:
                os.chdir(os.path.dirname(real))
                done = os.path.join(os.getcwd(), os.path.basename(real))
            except OSError:
                done = real
        else:
            done = nxt
        return os.path.normpath(os.path.join(done, *parts[k + 1:]))
    return done
def forms(p):
    return [f.casefold().rstrip(os.sep) or os.sep for f in (os.path.abspath(p), os.path.realpath(p), phys(p))]
try:
    cur = os.getcwd()
except OSError:
    no("the folder git was started in is gone")
trees = [os.path.abspath(t) for t in trees]
roots = set()
for t in trees:
    roots.update(forms(t))
cur = phys(cur)
paths = [cur]
i = 0
while i < len(args):
    a = args[i]
    if a == "-C":
        i += 1
        if i < len(args) and args[i]:
            cur = phys(os.path.join(cur, args[i]))
            paths.append(cur)
    elif a in ("--git-dir", "--work-tree"):
        i += 1
        if i < len(args):
            paths.append(os.path.join(cur, args[i]))
    elif a.startswith(("--git-dir=", "--work-tree=", "--exec-path=")):
        paths.append(os.path.join(cur, a.split("=", 1)[1]))
    elif a in ("-c", "--namespace", "--config-env", "--attr-source", "--super-prefix", "--list-cmds"):
        i += 1
    elif not a.startswith("-"):
        break
    i += 1
for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
             "GIT_EXEC_PATH", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
    for v in os.environ.get(name, "").split(os.pathsep):
        if v:
            paths.append(os.path.join(cur, v))
for p in paths:
    for form in forms(p):
        for r in roots:
            if r == os.sep or form == r or form.startswith(r + os.sep):
                no("%s is a folder agents can write to, and the engine never runs git there" % p)
'
/usr/bin/python3 -I -c "$GUARD" "${LIB_DIR:-/nonexistent}" "$@" || exit 128

export GIT_CEILING_DIRECTORIES="$HOME${GIT_CEILING_DIRECTORIES:+:$GIT_CEILING_DIRECTORIES}"
for real in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
  if [ -x "$real" ]; then
    exec "$real" -c safe.bareRepository=explicit -c core.fsmonitor=false -c core.hooksPath=/dev/null "$@"
  fi
done
echo "git: no git program found on this Mac" >&2
exit 127
