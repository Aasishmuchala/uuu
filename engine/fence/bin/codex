#!/usr/bin/env bash
# Codex inside the fence. Paperclip's codex_local adapter (runner legacy, engine
# cli: the default engine launches a different program and would bypass this
# wrapper) calls a file named `codex`, and this folder goes first on the board's
# PATH. See codex_home.py for what paperclip does around a Codex run and what
# the fence therefore allows.
set -euo pipefail
for _v in $(compgen -e); do
  case "$_v" in FENCE_*|UUU_*) unset "$_v" ;; esac
done
unset ENGINE_CONFIG _v
unset OPENAI_API_KEY ANTHROPIC_API_KEY ENGINE_RELAY_TOKEN
# Codex never needs the Claude login or a Claude endpoint: an inherited one must not reach
# the program or its shell tool (which gets the program's whole environment).
unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL

FENCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
refuse() { echo "fence: $1" >&2; exit 78; }
OWNER_HOME="$(/usr/bin/python3 -I -c "import os,pwd;print(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))")" \
  || refuse "could not find your home folder"
_given_home="${HOME:-}"; HOME="$OWNER_HOME"
. "$FENCE_DIR/../lib/config.sh" || refuse "the engine config could not be read. Check engine/config.json"
HOME="$_given_home"; unset _given_home
STATE_DIR="$CFG_STATE"
ENGINE_DIR="$CFG_ENGINE_DIR"

# The model mode, known before anything is shared: in provider mode the Codex
# login must be neither readable nor writable inside the fence (the program talks
# to the model relay and needs no login; what it could read could reach the provider).
LOGIN_MODE="$(/usr/bin/python3 -I "$FENCE_DIR/model_mode.py" --mode </dev/null)" || exit 78

# Paperclip picks the Codex home. Only homes the engine or paperclip made for an
# agent are accepted (codex_home.py checks), and the fence allows that one home.
# In provider mode the engine's shared home, which holds the login file itself,
# is swapped for an empty folder inside it.
CODEX_HOME="${CODEX_HOME:-$STATE_DIR/codex-home}"
if [[ "$LOGIN_MODE" == provider ]]; then
  _shared="$(cd "$STATE_DIR/codex-home" 2>/dev/null && pwd -P)" || _shared=""
  _given="$(cd "$CODEX_HOME" 2>/dev/null && pwd -P)" || _given=""
  if [[ -n "$_shared" && "$_given" == "$_shared" ]]; then
    CODEX_HOME="$_shared/provider-mode"
    [[ -d "$CODEX_HOME" && ! -L "$CODEX_HOME" ]] || mkdir -m 700 "$CODEX_HOME" \
      || refuse "could not make the Codex home for provider mode"
  fi
  unset _shared _given
fi
PLAN="$(/usr/bin/python3 -I "$FENCE_DIR/codex_home.py" "$CODEX_HOME" "$STATE_DIR" "$CFG_INSTANCE_ROOT" \
  "${PAPERCLIP_COMPANY_ID:-}" "${PAPERCLIP_AGENT_ID:-}")" || exit 78
PATHS=()
CODEX_HOME=""
while IFS="$(printf '\t')" read -r kind path; do
  case "$kind" in
    home) CODEX_HOME="$path" ;;
    read|write)
      # Every link of the login chain and its last file are named auth.json
      # (codex_home.py checks): none of them is shared in provider mode.
      if [[ "$LOGIN_MODE" == provider && "${path##*/}" == auth.json ]]; then continue; fi
      PATHS+=("--$kind" "$path") ;;
  esac
done <<EOF
$PLAN
EOF
[[ -n "$CODEX_HOME" ]] || refuse "no Codex home was worked out"
mkdir -p "$CODEX_HOME"
# A login that is a plain file inside the home the run uses would be readable in
# the fence (the home is). In provider mode such a run is refused; the file is
# never deleted. A link is fine: its target is not shared (see above).
if [[ "$LOGIN_MODE" == provider && -f "$CODEX_HOME/auth.json" && ! -L "$CODEX_HOME/auth.json" ]]; then
  refuse "a Codex login sits in this agent's own Codex home ($CODEX_HOME/auth.json), and the provider is on, so the run could read it. Remove that file, or switch the provider off in Settings"
fi
export CODEX_HOME
# The native Codex program and the relay that gives it pipes of its own.
PATHS+=(--read "$ENGINE_DIR/node_modules/@openai" --read "$FENCE_DIR/steady-pipes.py")

# Inside the fence Codex cannot ask macOS for its trusted certificates, so every
# HTTPS call fails ("error sending request") until it is pointed at the system bundle.
export SSL_CERT_FILE="/etc/ssl/cert.pem" CODEX_CA_CERTIFICATE="/etc/ssl/cert.pem"

# The proof tests the fence itself this way.
if [[ "${1:-}" == "--fence-check" ]]; then
  [[ $# -eq 2 ]] || refuse "--fence-check takes exactly one shell command"
  exec "$FENCE_DIR/fence-run" --tool codex --agent-home "$CODEX_HOME" "${PATHS[@]}" -c "$2"
fi

# Paperclip's quota check starts `codex ... app-server` from the server's own
# folder. Give that one an empty folder of its own instead of refusing it.
QUOTA_CHECK=""
for arg in "$@"; do
  if [[ "$arg" == "app-server" ]]; then
    mkdir -p "$STATE_DIR/tasks/_quota" && cd "$STATE_DIR/tasks/_quota"
    QUOTA_CHECK=1
    break
  fi
done

# Which models this run uses (PLAN-V4, C6): the Codex plan as today, or the
# owner's provider through the model relay. model_mode.py runs out here and
# refuses with its own sentence (exit 78). The quota check and a version question
# need no model and are left as today: no token, no settings. The relay token
# lives only in a shell variable and then the environment, never on a command line.
MODEL_MODE=plans
MODEL_PICK=""
RELAY_URL=""
_read_again=""
if [[ -z "$QUOTA_CHECK" && "$*" != "--version" && "$*" != "-V" ]]; then
  _read_again=1
  if [[ -z "${PAPERCLIP_AGENT_ID:-}" ]]; then
    MODEL_MODE="$(/usr/bin/python3 -I "$FENCE_DIR/model_mode.py" --mode)" || exit 78
    [[ "$MODEL_MODE" == "$LOGIN_MODE" ]] || refuse "the model mode changed while this run was starting"
    [[ "$MODEL_MODE" == plans ]] \
      || refuse "the provider is on, and a run without an agent id has no model. The proof passes a real agent's id."
  else
    NL=$'\n'
    _run="$(/usr/bin/python3 -I "$FENCE_DIR/model_mode.py" --for-run --agent "$PAPERCLIP_AGENT_ID")" || exit 78
    MODEL_MODE="${_run%%"$NL"*}"
    if [[ "$MODEL_MODE" == provider ]]; then
      _run="${_run#*"$NL"}"; RELAY_URL="${_run%%"$NL"*}"
      _run="${_run#*"$NL"}"; MODEL_PICK="${_run%%"$NL"*}"
      ENGINE_RELAY_TOKEN="${_run#*"$NL"}"
    fi
    unset _run
  fi
fi
# The mode was read once above to decide what to share: a switch in between would
# give one run both the login and a relay token.
if [[ -n "$_read_again" && "$MODEL_MODE" != "$LOGIN_MODE" ]]; then
  refuse "the model mode changed while this run was starting"
fi
unset _read_again
if [[ "$MODEL_MODE" == provider ]]; then
  [[ "$RELAY_URL" =~ ^http://127\.0\.0\.1:[0-9]{1,5}$ && "$MODEL_PICK" =~ ^[a-z0-9.-]{1,80}$ \
     && "$ENGINE_RELAY_TOKEN" =~ ^v1\.a\.[0-9a-f-]+\.[0-9]+\.[0-9a-f]{64}$ ]] \
    || refuse "the model relay's address, model or token for this run could not be worked out"
  export ENGINE_RELAY_TOKEN
elif [[ "$MODEL_MODE" != plans ]]; then
  refuse "the model settings for this run could not be worked out"
fi

# Paperclip tells Codex to hand its shell tool only a fixed list of variables.
# The fence's proxy settings are not on it, so every call from the shell tool to
# the board was refused ("Operation not permitted"). Add them, and the engine's
# UUU_* variables (fence-run exports them: the knowledge folder, the lessons
# file, the agent's own keys), by pattern and by the names in use today.
# TMPPREFIX: where zsh writes here-documents (fence-run points it at the temp folder).
EXTRA_NAMES='"HTTP_PROXY","HTTPS_PROXY","ALL_PROXY","NO_PROXY","http_proxy","https_proxy","all_proxy","no_proxy","GIT_SSH_COMMAND","SANDBOX_RUNTIME","SSL_CERT_FILE","TMPPREFIX","PAPERCLIP_RUNTIME_API_URL","UUU_*","UUU_KNOWLEDGE_DIR","UUU_LESSONS_FILE","UUU_BENCH_URL","UUU_BENCH_SITE","UUU_BENCH_API_KEY","UUU_BENCH_API_SECRET","UUU_CAD_PYTHON","UUU_CAD_EXPORT"'
#
# In provider mode Codex is pointed at the relay. The three settings go right
# after `exec`: Codex drops every -c given before `exec` when `exec` has -c of its
# own (paperclip always adds some), and they stay in front of `resume`. A model
# named with --model or -m beats -c model=, so that value becomes the pick too.
# The relay sets the model again on every call; this keeps Codex's own view right.
args=()
expect=""
placed=""
for arg in "$@"; do
  case "$arg" in
    shell_environment_policy.include_only=\[\]) arg="shell_environment_policy.include_only=[$EXTRA_NAMES]" ;;
    shell_environment_policy.include_only=\[*\]) arg="${arg%]},$EXTRA_NAMES]" ;;
  esac
  if [[ "$MODEL_MODE" == provider ]]; then
    if [[ -n "$expect" ]]; then
      [[ "$expect" == --model || "$expect" == -m ]] && arg="$MODEL_PICK"
      args+=("$arg"); expect=""; continue
    fi
    case "$arg" in
      --model=*) arg="--model=$MODEL_PICK" ;;
      -m=*) arg="-m=$MODEL_PICK" ;;
      -c|--config|--enable|--disable|-i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
      -a|--ask-for-approval|-C|--cd|--add-dir|--output-schema|--color|-o|--output-last-message|--remote)
        expect="$arg" ;;
    esac
    args+=("$arg")
    if [[ "$arg" == exec && -z "$placed" ]]; then
      args+=(-c 'model_provider="uuu-relay"'
             -c "model_providers.uuu-relay={name=\"Model relay\",base_url=\"$RELAY_URL/v1\",env_key=\"ENGINE_RELAY_TOKEN\",wire_api=\"responses\",requires_openai_auth=false,supports_websockets=false}"
             -c "model=\"$MODEL_PICK\"")
      placed=1
    fi
    continue
  fi
  args+=("$arg")
done
# Without `exec` the settings have nowhere to go, and Codex would try OpenAI,
# which the fence blocks in provider mode: the run would hang, so refuse it.
if [[ "$MODEL_MODE" == provider && -z "$placed" ]]; then
  refuse "the provider is on, and this Codex run has no exec, so it cannot be pointed at the model relay"
fi

# Run the native Codex program directly (what its Node launcher would do), through
# the small relay that gives it output pipes of its own.
export CODEX_MANAGED_PACKAGE_ROOT="$ENGINE_DIR/node_modules/@openai/codex" CODEX_MANAGED_BY_NPM=1
CODEX_BIN="$ENGINE_DIR/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"
[[ -x "$CODEX_BIN" ]] || refuse "the Codex program is missing ($CODEX_BIN)"
exec "$FENCE_DIR/fence-run" --tool codex --agent-home "$CODEX_HOME" "${PATHS[@]}" \
  -- /usr/bin/python3 "$FENCE_DIR/steady-pipes.py" "$CODEX_BIN" ${args[@]+"${args[@]}"}
