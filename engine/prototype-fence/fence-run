#!/usr/bin/env bash
# PROTOTYPE (fence trial). Runs a command inside the fence:
#   files   - the current folder and the agent's own home are readable and writable;
#             the rest of the owner's home folder cannot even be read
#   network - only the hosts on the allow-list
# It refuses to start in a folder that is not an agent task folder, so a wrong
# working folder can never turn the owner's home into "the task folder".
# Usage: fence-run <command> [args...]   or   fence-run -c '<shell command>'
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$(cd "$HERE/.." && pwd)"
STATE_DIR="${UUU_ENGINE_STATE:-$HOME/.paperclip/uuu-engine}"
AGENT_HOME="${UUU_AGENT_HOME:-$STATE_DIR/claude-home}"
NODE_ROOT="${UUU_NODE_ROOT:-$HOME/.nvm/versions/node/v24.13.0}"
WS="$(pwd -P)"
mkdir -p "$AGENT_HOME" "$STATE_DIR/fences"
# Temp folder for the command: paperclip's per-run folder when it gave one, else one inside the agent's home.
case "$(basename "${TMPDIR:-x}")" in
  paperclip-run-*) INNER_TMP="${TMPDIR%/}" ;;
  *) INNER_TMP="$AGENT_HOME/tmp" ;;
esac
mkdir -p "$INNER_TMP"
# The settings file is named after its own content, so two different fences
# (Claude and Codex, say) can never overwrite each other's rules.
SETTINGS="$(python3 "$HERE/fence-plan.py" "$STATE_DIR" "$HOME" "$WS" "$AGENT_HOME" "$NODE_ROOT" "${FENCE_EXTRA_READ:-}" "${FENCE_EXTRA_DOMAINS:-}" "$INNER_TMP" "${FENCE_EXTRA_WRITE:-}" "${FENCE_MODEL_DOMAINS:-api.anthropic.com}" "${FENCE_BOARD:-127.0.0.1:3100,localhost:3100}")"
export PATH="$NODE_ROOT/bin:$PATH"
# sandbox-runtime puts its control socket under TMPDIR, and a socket path has a
# hard length limit that paperclip's per-run temp folder overflows. So srt itself
# gets a short TMPDIR, and the command inside gets its real one back. NO_PROXY is
# emptied so that calls to the paperclip board on 127.0.0.1 also go through the
# fence's proxy: the proxy allows that one port and refuses every other local one.
SHORT_TMP="/tmp/uuu-fence-$(id -u)"
mkdir -p "$SHORT_TMP" && chmod 700 "$SHORT_TMP"
if [[ "${1:-}" == "-c" ]]; then
  TMPDIR="$SHORT_TMP" exec "$ENGINE_DIR/node_modules/.bin/srt" -s "$SETTINGS" -c "export TMPDIR='$INNER_TMP' CLAUDE_CODE_TMPDIR='$INNER_TMP' NO_PROXY= no_proxy=; $2"
fi
# macOS ships bash 3.2, where expanding an empty array under `set -u` is an error.
DEBUG_FLAG=""; [[ -n "${FENCE_DEBUG:-}" ]] && DEBUG_FLAG="-d"
TMPDIR="$SHORT_TMP" exec "$ENGINE_DIR/node_modules/.bin/srt" $DEBUG_FLAG -s "$SETTINGS" -- \
  env TMPDIR="$INNER_TMP" CLAUDE_CODE_TMPDIR="$INNER_TMP" NO_PROXY= no_proxy= "$@"
