#!/usr/bin/env bash
# PROTOTYPE (fence trial). Codex inside the fence. Paperclip's codex_local
# adapter reaches this through bin/codex.
#
# What paperclip does around a Codex run (read from its adapter, 2026.1106.0):
#   - it picks the Codex home itself: a generated folder per agent under
#     ~/.paperclip/instances/default/companies/<company>/codex-home/skill-runtimes/
#   - auth.json in that home is a chain of links ending at the shared login file
#   - skills are links pointing outside the home
#   - its start-up check and its quota check use the server's own CODEX_HOME
# So the fence allows: that one home (read and write), each link of the login
# chain, the skill folders the links point at (read only), and nothing else.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$(cd "$HERE/.." && pwd)"
# Fence rules never come from the environment paperclip passes in.
unset FENCE_EXTRA_READ FENCE_EXTRA_WRITE FENCE_EXTRA_DOMAINS FENCE_MODEL_DOMAINS FENCE_BOARD
unset UUU_ENGINE_STATE UUU_AGENT_HOME UUU_NODE_ROOT UUU_REAL_CLAUDE
unset OPENAI_API_KEY ANTHROPIC_API_KEY
STATE_DIR="$HOME/.paperclip/uuu-engine"
INSTANCE="$HOME/.paperclip/instances/default"
export CODEX_HOME="${CODEX_HOME:-$STATE_DIR/codex-home}"
mkdir -p "$CODEX_HOME"

PLAN="$(python3 - "$CODEX_HOME" "$STATE_DIR" "$INSTANCE" "${PAPERCLIP_COMPANY_ID:-}" "${PAPERCLIP_AGENT_ID:-}" <<'PY'
import os, re, sys
codex_home, state, instance, company, agent = sys.argv[1:6]
real = os.path.realpath(codex_home)
def inside(path, root):
    root = os.path.realpath(root)
    return path == root or path.startswith(root + '/')
uuid = r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
managed = re.match(r'^%s/companies/%s/(agents/%s/)?codex-home(/|$)' % (re.escape(os.path.realpath(instance)), uuid, uuid), real)
if not (inside(real, os.path.join(state, 'codex-home')) or managed):
    sys.exit('fenced-codex: refusing Codex home %s: not one the engine or paperclip made for an agent' % codex_home)
read, write = [], []
# The login file: follow the chain of links, allow each link to be read and the last file to be written.
hop, seen = os.path.join(real, 'auth.json'), 0
while os.path.islink(hop) and seen < 8:
    read.append(hop)
    hop = os.path.normpath(os.path.join(os.path.dirname(hop), os.readlink(hop)))
    seen += 1
if os.path.exists(hop) and not inside(os.path.realpath(hop), real):
    write.append(os.path.realpath(hop))
# Skills: links pointing outside the home.
skills = os.path.join(real, 'skills')
if os.path.isdir(skills):
    for name in os.listdir(skills):
        target = os.path.realpath(os.path.join(skills, name))
        if os.path.exists(target) and not inside(target, real):
            read.append(target)
# The instructions folder of this agent. (No apostrophes in here: bash 3.2 miscounts quotes inside a heredoc in a command substitution.)
if re.fullmatch(uuid, company) and re.fullmatch(uuid, agent):
    path = os.path.join(instance, 'companies', company, 'agents', agent, 'instructions')
    if os.path.isdir(path):
        read.append(path)
print(real); print(':'.join(read)); print(':'.join(write))
PY
)"
CODEX_HOME="$(printf '%s\n' "$PLAN" | sed -n 1p)"
export CODEX_HOME
export UUU_AGENT_HOME="$CODEX_HOME"
FENCE_EXTRA_READ="$(printf '%s\n' "$PLAN" | sed -n 2p)"
export FENCE_EXTRA_READ="${FENCE_EXTRA_READ:+$FENCE_EXTRA_READ:}$ENGINE_DIR/node_modules/@openai:$HERE/steady-pipes.py"
FENCE_EXTRA_WRITE="$(printf '%s\n' "$PLAN" | sed -n 3p)"
export FENCE_EXTRA_WRITE
export FENCE_MODEL_DOMAINS="chatgpt.com,api.openai.com,auth.openai.com"
# Inside the fence Codex cannot ask macOS for its trusted certificates, so every
# HTTPS call fails ("error sending request") until it is pointed at the system bundle.
export SSL_CERT_FILE="/etc/ssl/cert.pem" CODEX_CA_CERTIFICATE="/etc/ssl/cert.pem"

if [[ "${1:-}" == "--fence-check" ]]; then exec "$HERE/fence-run" -c "$2"; fi

# Paperclip's quota check starts `codex ... app-server` from the server's own
# folder. Give that one an empty folder instead of refusing it.
for arg in "$@"; do
  if [[ "$arg" == "app-server" ]]; then mkdir -p "$STATE_DIR/workspaces/_quota" && cd "$STATE_DIR/workspaces/_quota"; break; fi
done
# PROTOTYPE: record how paperclip calls us, to learn what the fence must allow.
{ printf '%s codex cwd=%s home=%s\n' "$(date '+%F %T')" "$PWD" "$CODEX_HOME"; printf '  arg: %s\n' "$@" | cut -c1-300; } >> "$STATE_DIR/calls.log" 2>/dev/null || true
# Codex hands its shell tool only the variables paperclip lists. Add the fence's
# proxy settings to that list: without them every call the shell tool makes to
# the paperclip board is refused ("Operation not permitted").
PROXY_NAMES='"HTTP_PROXY","HTTPS_PROXY","ALL_PROXY","NO_PROXY","http_proxy","https_proxy","all_proxy","no_proxy","GIT_SSH_COMMAND","SANDBOX_RUNTIME","SSL_CERT_FILE"'
args=()
for arg in "$@"; do
  case "$arg" in
    shell_environment_policy.include_only=\[\]) arg="shell_environment_policy.include_only=[$PROXY_NAMES]" ;;
    shell_environment_policy.include_only=\[*\]) arg="${arg%]},$PROXY_NAMES]" ;;
  esac
  args+=("$arg")
done
# Run the native Codex program directly (what its Node launcher would do), through
# the small relay that gives it output pipes of its own.
export CODEX_MANAGED_PACKAGE_ROOT="$ENGINE_DIR/node_modules/@openai/codex" CODEX_MANAGED_BY_NPM=1
CODEX_BIN="$ENGINE_DIR/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"
exec "$HERE/fence-run" /usr/bin/python3 "$HERE/steady-pipes.py" "$CODEX_BIN" ${args[@]+"${args[@]}"}
